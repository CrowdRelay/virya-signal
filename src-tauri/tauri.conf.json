{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virya Signal",
  "version": "0.4.2",
  "identifier": "music.virya.signal",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Virya Signal",
        "width": 430,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#080808"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://signal-api.virya.music; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Virya Signal and live operations",
    "longDescription": "Concerts, fan rewards, mobile ticket wallet, QR admission and live operations powered by CrowdRelay.",
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26,
      "versionCode": 2009
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/virya-signal-brand-full.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
