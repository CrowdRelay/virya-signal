{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{APP_NAME}}",
  "version": "{{APP_VERSION}}",
  "identifier": "{{PACKAGE_ID}}",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "{{APP_NAME}}",
        "width": 430,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "{{SURFACE_COLOR}}"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost {{CSP_CONNECT_SOURCES}}; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "{{APP_SHORT_DESCRIPTION}}",
    "longDescription": "{{APP_LONG_DESCRIPTION}}",
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26,
      "versionCode": {{ANDROID_VERSION_CODE}}
    },
    "icon": [
      "icons/tenant/32x32.png",
      "icons/tenant/128x128.png",
      "icons/tenant/128x128@2x.png",
      "icons/tenant/256x256.png",
      "icons/tenant/512x512.png",
      "icons/tenant/icon.ico",
      "icons/tenant/icon.icns"
    ]
  }
}
